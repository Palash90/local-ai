    "system_level_improvement_levers": [
        {
            "rank": 1,
            "lever": "Category-routed system prompts",
            "description": "Classify request type, apply a tailored system prompt per category instead of one generic prompt."
        },
        {
            "rank": 2,
            "lever": "Output-side guardrails",
            "description": "Validate the *response* (not just input); catches novel jailbreak phrasing and verifies structured output."
        },
        {
            "rank": 3,
            "lever": "Retrieval grounding for research-mode items",
            "description": "Require citing/quoting retrieved sources instead of trusting the model's own recall; biggest fix for confident-but-wrong research answers."
        },
        {
            "rank": 4,
            "lever": "Per-category sampling params",
            "description": "Lower temperature/top-p for factual/research items, higher for creative and music generation."
        },
        {
            "rank": 5,
            "lever": "Few-shot anchoring in-prompt",
            "description": "1–2 worked examples for structurally fussy tasks (chord+melody+rhythm+alt-key, translation naturalness, dataset analysis)."
        },
        {
            "rank": 6,
            "lever": "Self-consistency sampling",
            "description": "Generate research/factual answers 2–3x, compare, flag disagreement."
        },
        {
            "rank": 7,
            "lever": "Session isolation enforcement",
            "description": "Explicitly reject 'we already agreed to this earlier' as a valid instruction source."
        },
        {
            "rank": 8,
            "lever": "Standing regression eval harness",
            "description": "Turn this spec into a repeatable test suite re-run after any prompt/config change."
        },
        {
            "rank": 9,
            "lever": "Parallelized batch queue",
            "description": "Concurrent sessions instead of one sequential queue cuts wall-clock iteration time (Infra level)."
        }
    ]
