# ── local-ai .env template ──────────────────────────────────────────
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit secrets. Run `python3 scripts/check_env.py`
# to validate the required variables before starting services.
#
# Legend:  <empty> = optional / falls back to the code default shown in comment
#          CHANGE_ME = required secret with no safe default

# ── Chat server ──
CHAT_HOST=127.0.0.1
CHAT_API_BASE=http://127.0.0.1:3001
SHARE_BASE_URL=
MCP_HOST=127.0.0.1
MCP_TOOL_TIMEOUT=300
FORCE_GPU_LANE=false

# ── Models / VRAM ──
BASE_MODELS_DIR=
GPU_CTX_SIZE=24576
GPU_CTX_SIZE_26B=32768
CPU_CTX_SIZE=32768
MAX_INPUT_TOKENS=24576
MAX_OUTPUT_TOKENS=4096
REASONING_BUDGET=1024
CPU_IDLE_UNLOAD_SECONDS=300
CPU_KV_SAVE_INTERVAL_SECONDS=120
OMP_NUM_THREADS=
OPENBLAS_NUM_THREADS=
IMAGE_RENDER_RAM_HEADROOM_MB=4000
COMFYUI_RECYCLE_AFTER_RENDER=1

# ── Guardrail / judge lane (:8083) ──
GUARD_LLM_BASE=http://localhost:8083
GUARD_LLM_MODEL=
GUARD_LLM_MAX_TOKENS=2048
GUARD_LLM_REASONING_BUDGET=256
GUARD_LLM_TIMEOUT=240
GUARD_FAIL_CLOSED=1
VERIFY_MODEL=gemma-4-E2B-it-Q4_K_M
VERIFY_PORT=8083
VERIFY_CONTEXT_SIZE=8192
VERIFY_IDLE_TIMEOUT=300

# ── Embeddings ──
LOCAL_AI_EMBED_URL=http://localhost:8084
LOCAL_AI_EMBED_MODEL=nomic-embed-text-v1.5.Q8_0
LOCAL_AI_EMBED_DIM=768
LOCAL_AI_DB=
LOCAL_AI_PAGE_CACHE=
LOCAL_AI_PENSIEVE_DB=

# ── Pensieve / relevance ──
PENSIEVE_BLOCK_MAX_CHARS=12000
PENSIEVE_MAX_UNITS=200
PENSIEVE_TOPIC_MAX_CHARS=120
RELEVANCE_DISTILL=1
RELEVANCE_KEEP_RECENT=6
RELEVANCE_WATERMARK_FRAC=0.55

# ── Thermal pacing ──
THERMAL_PACE_START_C=80
THERMAL_PACE_SCALE=2.0
THERMAL_PACE_MAX_S=20.0
PLATFORM_TEMP_PATH=

# ── OIDC auth (authentik) ──
AUTHENTIK_BASE_URL=https://home.palashkantikundu.in/sso
AUTH_CLIENT_ID=local-ai
AUTH_CLIENT_SECRET=
AUTH_AGENTS_CLIENT_ID=
AUTH_AGENTS_CLIENT_SECRET=
AUTH_AGENTS_APP_SLUG=
AUTH_NC_CLIENT_ID=
AUTH_NC_CLIENT_SECRET=
AUTH_SCOPE=openid profile email groups
AUTHENTIK_TOKEN=
AUTHENTIK_OUTPOST_TOKEN=
AUTHENTIK_COOKIE_DOMAIN=
AUTHENTIK_TAG=

# ── MCP lane ──
MCP_USER=
MCP_USER_PASSWORD=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_ALLOWED_USERS=
TTS_INTERNAL_TOKEN=

# ── Self-chat ──
SELF_CHAT_MODE=cpu
SELF_CHAT_PASSWORD=
SELF_CHAT_A_PASSWORD=
SELF_CHAT_B_PASSWORD=
SELF_CHAT_EDITOR_PASSWORD=
SELF_CHAT_MODERATOR_PASSWORD=
SELF_CHAT_EDITOR_MIN_CONFIDENCE=70
SELF_CHAT_EDITOR_RESTARTS=2
SELF_CHAT_REPLAY_ATTEMPTS=2
SELF_CHAT_RETRY_ATTEMPTS=8
SELF_CHAT_ALIGNMENT=1
SELF_CHAT_PIN_CAST=0
AGENT_PEER_MAP={"kaya": "kolpo", "kolpo": "kaya"}

# ── Web search ──
SEARXNG_URL=http://127.0.0.1:8080/
SEARXNG_PUBLIC_URL=http://127.0.0.1:8080
WEB_SEARCH_MIN_INTERVAL=20
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── OpenAI-compatible lane ──
OPENAI_API_KEY=

# ── TTS ──
TTS_MAX_CHARS=8000
TTS_MAX_CHARS_PUBLIC=8000
TTS_CHUNK_CHARS=1800
TTS_CACHE_MAX_BYTES=1073741824
TTS_CACHE_SECONDARY_DIR=

# ── Music ──
MUSIC_OPUS_BITRATE=64000
FLUID_SOUNDFONT=
FLUID_SOUNDFONT_MAP=
FLUIDSYNTH_BIN=

# ── OCR ──
TESSDATA_PREFIX=
TESSERACT_LANG=

# ── Media / stories / surface patterns ──
IMG_PATH=/tmp
CONTEXTS_DIR=
STORIES_ADMIN_DIR=
STORIES_FREE_DIR=
STORIES_PREMIUM_DIR=
SURFACE_ATTACKS_DIR=
SURFACE_ATTACKS_KEY=

# ── DDNS (GoDaddy) ──
DDNS_DOMAIN=palashkantikundu.in
DDNS_SUBDOMAIN=home
DDNS_CHECK_INTERVAL=300
GODADDY_API_KEY=
GODADDY_API_SECRET=
HEARTBEAT_URL=http://10.66.66.1:9863/heartbeat

# ── Postgres + authentik compose (REQUIRED for authentik-compose.yaml) ──
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME
