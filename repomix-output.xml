                    {"title": "T%d" % i, "url": "http://x/%d" % i, "content": "snippet%d" % i}
                    for i in range(5)
                ]}

        seen = []
        monkeypatch.setattr(chat_webui.requests, "get", lambda *a, **k: FakeResp())

