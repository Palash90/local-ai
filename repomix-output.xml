}

.share-modal-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.share-modal-actions button,
.share-open-link {
  padding: 8px 14px;
  border-radius: 8px;
  border: none;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
