                self.send_json({"error": "Unauthorized"}, status=401)
                return
            self.send_json({"shares": list_shares(user)})
        elif self.path.startswith("/api/public/share/"):
            token = os.path.basename(self.path)
            rec = get_share(token)
            if not rec:
