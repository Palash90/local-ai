  font-family: inherit;
}

.share-modal-close:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
}

.share-modal-hint {
  color: #94a3b8;
  font-size: 12px;
  margin: 0 0 12px;
  line-height: 1.5;
}

.share-modal-url {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.05);
  color: #e0e0e0;
  font-size: 13px;
  font-family: monospace;
  outline: none;
